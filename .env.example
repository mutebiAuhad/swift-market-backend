# ---- Copy this file to ".env" and fill in real values. Never commit ".env" ----

PORT=3000
NODE_ENV=production
PUBLIC_URL=https://your-real-domain.com

# Auth — generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string

# The one platform administrator account.
ADMIN_EMAIL=mutebiauhad4@gmail.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YourStrongPassword123', 10))"
ADMIN_PASSWORD_HASH=paste-the-bcrypt-hash-here
# A long random secret that gates the /admin-panel URL itself. Generate with
# `openssl rand -hex 24`. Run scripts/send-admin-link.js to email yourself
# the full link once this and PUBLIC_URL are set.
ADMIN_ACCESS_TOKEN=change-this-too

# Business rules
WEEKLY_FEE_UGX=50000
FREE_LAUNCH_SLOTS=10
PLATFORM_COMMISSION_PERCENT=5

# ---- Email (recovery codes, admin link) ----
# Gmail example: create an "app password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Swift Market <your-sending-address@gmail.com>"

# ---- MTN MoMo Collections API (business subscription payments) ----
# https://momodeveloper.mtn.com — subscribe to "Collections"
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=your-ocp-apim-subscription-key
MOMO_API_USER=your-generated-api-user-uuid
MOMO_API_KEY=your-generated-api-key

# ---- Flutterwave (customer checkout: cards, MTN MoMo, Airtel Money) ----
# https://dashboard.flutterwave.com — use test keys first, then live keys
FLW_SECRET_KEY=your-flutterwave-secret-key

# ---- AI shopping assistant ----
# https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
