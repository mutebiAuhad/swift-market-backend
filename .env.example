# --- Core ---
PORT=3000
PUBLIC_URL=https://your-app.onrender.com
JWT_SECRET=replace-with-a-long-random-string

# --- Database (Render/Neon Postgres connection string) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Admin login (you, the only backend user) ---
ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hash-password.js "your-chosen-password"
ADMIN_PASSWORD_HASH=
# Random long string of your choosing — this is the secret in your admin panel link:
# https://your-app.onrender.com/admin-panel?token=THIS_VALUE
ADMIN_ACCESS_TOKEN=
# Optional but recommended: log in to the admin panel once with ADMIN_TOTP_SECRET blank,
# use the "Set up 2FA" button to get a QR code, scan it in Google Authenticator/Authy,
# then paste the base32 secret shown into this variable and redeploy to require it from then on.
ADMIN_TOTP_SECRET=

# --- Subscription price ---
SUBSCRIPTION_PRICE_USD=40

# --- Stripe (automated card payments, recurring monthly) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin a specific Stripe Price ID instead of auto-creating one on first checkout
STRIPE_PRICE_ID=

# --- Cloudinary (photo/video storage — required, do not skip) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) — leave blank to just log emails to the console instead of sending ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Geo-blocking ---
# Comma-separated ISO country codes to block. Defaults to the East African Community:
# Uganda, Kenya, Tanzania, Rwanda, Burundi, South Sudan, DR Congo, Somalia.
BLOCKED_COUNTRY_CODES=UG,KE,TZ,RW,BI,SS,CD,SO
